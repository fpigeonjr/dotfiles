.ssh/id_*
.ssh/known_hosts
**/*secret*
**/*.local
**/local.*
**/*token*
shell/.profile
aws/.aws/cli/
aws/.aws/sso/
shell/.config/zsh/local.zsh
config/.config/nvim/lazyvim.json
session-*.md

# keys and certificates
*.pem
*.p12
*.pfx
*.key

# credential files
**/.netrc
**/credentials
**/.env
!**/.env.example

# pi coding agent runtime state — not dotfiles (covers pi/, pi-gfe/, any future pi-* packages)
pi*/.config/pi/agent/auth.json
pi*/.config/pi/agent/trust.json
pi*/.config/pi/agent/sessions/
pi*/.config/pi/agent/git/
pi*/.config/pi/agent/npm/
pi*/.config/pi/agent/models.json
pi*/.config/pi/agent/models-store.json
pi*/.config/pi/agent/codex-home/
# generated by `herdr integration install pi`
pi*/.config/pi/agent/extensions/herdr-agent-state.ts

# opencode runtime state
config/.config/opencode/opencode-notifier-state.json

# herdr runtime state (when ~/.config/herdr is directory-folded by stow)
herdr/.config/herdr/*.log
herdr/.config/herdr/*.sock
herdr/.config/herdr/session.json
herdr/.config/herdr/release-notes.json

# herdr-managed opencode integration files — overwritten by herdr on update/reinstall
config/.config/opencode/tui.jsonc
config/.config/opencode/herdr-tui-session.js
config/.config/opencode/plugins/herdr-agent-state.js

# zed runtime databases
config/.config/zed/prompts/
