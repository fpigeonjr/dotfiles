{
  "$comment": "Pi coding agent settings for GFE. Keep this file minimal per pi philosophy. See https://github.com/badlogic/pi-mono/blob/main/packages/coding-agent/docs/settings.json",
  "defaultProvider": "usai",
  "defaultModel": "gpt-5.6-luna",
  "defaultThinkingLevel": "off",
  "enableInstallTelemetry": false,
  "terminal": {
    "showTerminalProgress": true
  },
  "retry": {
    "provider": {
      "timeoutMs": 3600000
    }
  },
  "lastChangelogVersion": "1.3.0",
  "skills": [
    "~/Code/skills/skills"
  ],
  "theme": "dark",
  "packages": [
    "npm:pi-herdr-agents",
    "npm:pi-herdr-roles"
  ]
}