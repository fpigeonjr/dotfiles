{
  "$comment": "Pi coding agent settings. Keep this file minimal per pi philosophy — add customization only when a real task demands it. See https://github.com/badlogic/pi-mono/blob/main/packages/coding-agent/docs/settings.json",
  "defaultProvider": "github-copilot",
  "defaultModel": "claude-haiku-5.5",
  "defaultThinkingLevel": "off",
  "enableInstallTelemetry": false,
  "terminal": {
    "showTerminalProgress": true
  },
  "retry": {
    "provider": {
      "timeoutMs": 3600000
    }
  },
  "lastChangelogVersion": "1.4.0",
  "skills": [
    "~/Code/skills/skills"
  ],
  "theme": "dark",
  "modelThinkingLevels": {
    "deepseek/deepseek-flash": "off",
    "deepseek/deepseek-v4-pro": "high"
  },
  "packages": [
    "npm:pi-herdr-agents",
    "npm:pi-herdr-roles"
  ]
}