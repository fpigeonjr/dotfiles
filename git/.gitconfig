[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[user]
	name = Frank Pigeon Jr.
	email = 4629398+fpigeonjr@users.noreply.github.com
	signingkey = ~/.ssh/id_ed25519.pub
	username = fpigeonjr

# Keep this personal profile's identity distinct from work profiles.
# Set work identity with repository-local `git config user.email`, or maintain
# explicit directory-scoped includeIf rules in ~/.gitconfig.local (included at
# the bottom of this file so local settings override defaults; not tracked).
# Do not automatically include the GFE machine-wide identity file here.

[init]
	defaultBranch = main

[core]
	editor = nvim
	excludesfile = ~/.gitignore_global

[gpg]
	format = ssh

[gpg "ssh"]
	# Local verification of SSH-signed commits (signing itself needs only
	# user.signingkey). Public key + public GitHub identity only.
	allowedSignersFile = ~/.config/git/allowed_signers

[commit]
	gpgsign = true

[pull]
	rebase = true

[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
[credential "https://github.com"]
	helper = 
	helper = "!env \"PATH=/opt/homebrew/bin:/usr/local/bin:$PATH\" gh auth git-credential"
[credential "https://gist.github.com"]
	helper = 
	helper = "!env \"PATH=/opt/homebrew/bin:/usr/local/bin:$PATH\" gh auth git-credential"

# Machine-local overrides and directory-scoped includeIf rules (last-value-wins).
[include]
	path = ~/.gitconfig.local
