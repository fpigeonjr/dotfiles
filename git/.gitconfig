[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[user]
	name = Frank Pigeon Jr.
	email = 4629398+fpigeonjr@users.noreply.github.com
	signingkey = ~/.ssh/id_ed25519.pub
	username = fpigeonjr

# Keep this personal profile's identity distinct from work profiles.
# Set work identity with repository-local `git config user.email`, or maintain
# explicit directory-scoped includeIf rules in machine-local configuration.
# Do not automatically include the GFE machine-wide identity file here.

[init]
	defaultBranch = main

[core]
	editor = nvim
	excludesfile = ~/.gitignore_global

[gpg]
	format = ssh

[commit]
	gpgsign = true

[pull]
	rebase = true

[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
