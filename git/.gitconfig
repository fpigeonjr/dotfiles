[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[user]
	name = Frank Pigeon Jr.
	email = 4629398+fpigeonjr@users.noreply.github.com
	signingkey = ~/.ssh/id_ed25519.pub
	username = fpigeonjr

# Machine-local overrides (email, signingkey, etc.)
# Create ~/.gitconfig.local on any machine that needs different values.
# Only applies to repos with a github.helix.gsa.gov remote (SSH or HTTPS).
# Safe no-op if the file does not exist.
[includeIf "hasconfig:remote.*.url:https://github.helix.gsa.gov/**"]
	path = ~/.gitconfig.local
[includeIf "hasconfig:remote.*.url:git@github.helix.gsa.gov:*/**"]
	path = ~/.gitconfig.local

[init]
	defaultBranch = main

[core]
	editor = nvim
	excludesfile = ~/.gitignore_global

[gpg]
	format = ssh

[commit]
	gpgsign = true

[pull]
	rebase = true

[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://github.helix.gsa.gov"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
